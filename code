BASE_FEATURES = [
    "amount_ratio_to_entity_mean",
    "entity_z_amount",
    "median_difference_ratio",
    "entity_frequency",
    "category_frequency",
    "category_amount_ratio",
    "vendor_frequency",
    "vendor_amount_ratio",
    "entity_vendor_frequency",
    "days_since_previous",
    "daily_entity_count"
]


def fit_behavior_baseline(
    df,
    entity_col,
    amount_col,
    category_col,
    vendor_col,
    date_col
):

    data = df.copy()

    data[amount_col] = pd.to_numeric(
        data[amount_col],
        errors="coerce"
    ).fillna(0)

    data[date_col] = pd.to_datetime(
        data[date_col],
        errors="coerce"
    )

    data[entity_col] = (
        data[entity_col]
        .fillna("UNKNOWN")
        .astype(str)
    )

    data[category_col] = (
        data[category_col]
        .fillna("UNKNOWN")
        .astype(str)
    )

    data[vendor_col] = (
        data[vendor_col]
        .fillna("UNKNOWN")
        .astype(str)
    )


    # Entity statistics
    entity_stats = (
        data
        .groupby(entity_col)[amount_col]
        .agg(
            entity_mean="mean",
            entity_std="std",
            entity_median="median",
            entity_frequency="count"
        )
        .reset_index()
    )

    entity_stats["entity_std"] = (
        entity_stats["entity_std"]
        .fillna(0)
    )


    # Category statistics
    category_stats = (
        data
        .groupby(category_col)[amount_col]
        .agg(
            category_mean="mean",
            category_frequency="count"
        )
        .reset_index()
    )


    # Vendor statistics
    vendor_stats = (
        data
        .groupby(vendor_col)[amount_col]
        .agg(
            vendor_mean="mean",
            vendor_frequency="count"
        )
        .reset_index()
    )


    # Entity-vendor frequency
    entity_vendor_stats = (
        data
        .groupby(
            [entity_col, vendor_col]
        )[amount_col]
        .count()
        .reset_index(
            name="entity_vendor_frequency"
        )
    )


    # Global fallbacks
    global_stats = {
        "amount_mean": data[amount_col].mean(),
        "amount_std": data[amount_col].std(),
        "amount_median": data[amount_col].median(),
        "category_mean": data[amount_col].mean(),
        "vendor_mean": data[amount_col].mean(),
        "category_frequency": 1,
        "vendor_frequency": 1,
        "entity_frequency": 1
    }


    return {
        "entity_stats": entity_stats,
        "category_stats": category_stats,
        "vendor_stats": vendor_stats,
        "entity_vendor_stats": entity_vendor_stats,
        "global_stats": global_stats
    }


def create_behavior_features(
    df,
    baseline,
    entity_col,
    amount_col,
    category_col,
    vendor_col,
    date_col
):

    data = df.copy()

    data[amount_col] = pd.to_numeric(
        data[amount_col],
        errors="coerce"
    ).fillna(0)

    data[date_col] = pd.to_datetime(
        data[date_col],
        errors="coerce"
    )

    data[entity_col] = (
        data[entity_col]
        .fillna("UNKNOWN")
        .astype(str)
    )

    data[category_col] = (
        data[category_col]
        .fillna("UNKNOWN")
        .astype(str)
    )

    data[vendor_col] = (
        data[vendor_col]
        .fillna("UNKNOWN")
        .astype(str)
    )


    # --------------------------------------------------------
    # Preserve original ordering for output
    # --------------------------------------------------------

    data["_original_order"] = np.arange(
        len(data)
    )


    # --------------------------------------------------------
    # Sort for time-based calculations
    # --------------------------------------------------------

    data = data.sort_values(
        [entity_col, date_col]
    ).reset_index(drop=True)


    data["amount"] = data[amount_col]


    # --------------------------------------------------------
    # Entity statistics
    # --------------------------------------------------------

    data = data.merge(
        baseline["entity_stats"],
        on=entity_col,
        how="left"
    )


    # Global fallback
    global_stats = baseline["global_stats"]

    data["entity_mean"] = (
        data["entity_mean"]
        .fillna(global_stats["amount_mean"])
    )

    data["entity_std"] = (
        data["entity_std"]
        .fillna(global_stats["amount_std"])
    )

    data["entity_median"] = (
        data["entity_median"]
        .fillna(global_stats["amount_median"])
    )

    data["entity_frequency"] = (
        data["entity_frequency"]
        .fillna(global_stats["entity_frequency"])
    )


    # --------------------------------------------------------
    # Entity behavioral features
    # --------------------------------------------------------

    data["amount_ratio_to_entity_mean"] = (
        data["amount"] /
        (data["entity_mean"] + 1e-6)
    )

    data["entity_z_amount"] = (
        (data["amount"] - data["entity_mean"])
        /
        (data["entity_std"] + 1e-6)
    )

    data["median_difference_ratio"] = (
        abs(
            data["amount"]
            - data["entity_median"]
        )
        /
        (data["entity_median"] + 1e-6)
    )


    # --------------------------------------------------------
    # Category behavior
    # --------------------------------------------------------

    data = data.merge(
        baseline["category_stats"],
        on=category_col,
        how="left"
    )

    data["category_mean"] = (
        data["category_mean"]
        .fillna(global_stats["category_mean"])
    )

    data["category_frequency"] = (
        data["category_frequency"]
        .fillna(0)
    )

    data["category_amount_ratio"] = (
        data["amount"] /
        (data["category_mean"] + 1e-6)
    )


    # --------------------------------------------------------
    # Vendor behavior
    # --------------------------------------------------------

    data = data.merge(
        baseline["vendor_stats"],
        on=vendor_col,
        how="left"
    )

    data["vendor_mean"] = (
        data["vendor_mean"]
        .fillna(global_stats["vendor_mean"])
    )

    data["vendor_frequency"] = (
        data["vendor_frequency"]
        .fillna(0)
    )

    data["vendor_amount_ratio"] = (
        data["amount"] /
        (data["vendor_mean"] + 1e-6)
    )


    # --------------------------------------------------------
    # Entity-vendor relationship
    # --------------------------------------------------------

    data = data.merge(
        baseline["entity_vendor_stats"],
        on=[
            entity_col,
            vendor_col
        ],
        how="left"
    )

    data["entity_vendor_frequency"] = (
        data["entity_vendor_frequency"]
        .fillna(0)
    )


    # --------------------------------------------------------
    # Time behavior
    #
    # For each dataset, calculate elapsed time within entity.
    # This does not use the target label.
    # --------------------------------------------------------

    data["days_since_previous"] = (
        data
        .groupby(entity_col)[date_col]
        .diff()
        .dt.total_seconds()
        .div(86400)
    )

    data["days_since_previous"] = (
        data["days_since_previous"]
        .fillna(999)
        .clip(lower=0)
    )


    # --------------------------------------------------------
    # Daily transaction count
    # --------------------------------------------------------

    data["date_only"] = (
        data[date_col].dt.date
    )

    data["daily_entity_count"] = (
        data
        .groupby(
            [
                entity_col,
                "date_only"
            ]
        )[amount_col]
        .transform("count")
    )


    # --------------------------------------------------------
    # Final cleanup
    # --------------------------------------------------------

    data = data.replace(
        [np.inf, -np.inf],
        np.nan
    )

    data[BASE_FEATURES] = (
        data[BASE_FEATURES]
        .fillna(0)
    )


    # Restore original ordering
    data = data.sort_values(
        "_original_order"
    ).reset_index(drop=True)

    data = data.drop(
        columns=["_original_order"]
    )

    return data


