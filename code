def explain_investigation(row):

    reasons = []

    if (
        row[
            "behavior_anomaly_index"
        ] >= 75
    ):
        reasons.append(
            "Strong behavioral anomaly"
        )

    if (
        row[
            "mp_expenditure_flag"
        ] == 1
    ):
        reasons.append(
            "Unusually high expenditure for MP"
        )

    if (
        row[
            "vendor_activity_flag"
        ] == 1
    ):
        reasons.append(
            "Unusually high vendor activity"
        )

    if (
        row[
            "repeated_pattern_flag"
        ] == 1
    ):
        reasons.append(
            "Repeated transaction pattern"
        )

    if row[
        "rapid_expenditure"
    ]:
        reasons.append(
            "Rapid expenditure pattern"
        )

    if bool(
        row[
            "over_allocation"
        ]
    ):
        reasons.append(
            "Observed expenditure exceeds recorded allocation"
        )

    if not reasons:

        reasons.append(
            "No major contextual warning signal"
        )

    return "; ".join(reasons)


